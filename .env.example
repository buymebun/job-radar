# --- Telegram, аккаунт-ПАРСЕР (не личный) ---
# Получить на https://my.telegram.org -> API development tools (зайти с аккаунта-парсера)
TG_API_ID=
TG_API_HASH=
# имя файла сессии в папке data/ (data/parser.session)
TG_SESSION=parser

# --- Отдельное VPN-подключение для радара (необязательно) ---
# Весь трафик радара (Telegram, Gemini, бот уведомлений) пойдёт через этот прокси; остальная система — как обычно.
# Если прокси задан, но не отвечает — радар НЕ стартует (не уходит в прямое соединение).
# Примеры: socks5://127.0.0.1:10808  (v2rayN / Nekoray / Xray — локальный SOCKS)
#          socks5://user:pass@1.2.3.4:1080  (SOCKS5 от VPN-провайдера)
PROXY_URL=

# --- LLM (цепочка Gemini -> Groq -> Ollama, см. README: LLM setup) ---
# Gemini: https://aistudio.google.com/apikey (бесплатно, ~450 запросов в сутки)
GEMINI_API_KEY=
# Groq (необязательно): https://console.groq.com/keys
GROQ_API_KEY=
# если Groq недоступен из твоей сети — http/socks прокси, иначе оставь пустым
GROQ_PROXY=
# Ollama (необязательно, локальная модель): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Уведомления (необязательно) ---
# Обычный бот от @BotFather, пишет тебе на ЛИЧНЫЙ аккаунт.
# NOTIFY_CHAT_ID — твой user id (узнать у @userinfobot). Перед этим нажми /start у своего бота.
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# --- Дашборд ---
# 127.0.0.1 — только с ноута; 0.0.0.0 — ещё и из домашней сети (нужен DASH_PASSWORD)
WEB_HOST=127.0.0.1
WEB_PORT=8765
# Адрес для ссылок в уведомлениях (адрес ноута в домашней сети)
PUBLIC_URL=http://192.168.1.X:8765
# Вход с других устройств (с самого ноута пароль не спрашивается)
DASH_USER=admin
DASH_PASSWORD=

# --- Папка с CV и трекером откликов (для карточек и MCP) ---
CV_ROOT=
